# Runtime
NODE_ENV=production
PORT=3000
FORGE_API_TOKEN=replace-with-a-random-token-at-least-32-characters

# PostgreSQL (use a strong, unique password in production)
DATABASE_URL=postgres://forge:change-me@db:5432/prometheus_forge
DATABASE_SSL=false
POSTGRES_PASSWORD=change-me

# Bootstrap administrator — required only by `npm run db:provision-admin`
FORGE_ADMIN_EMAIL=admin@example.com
FORGE_ADMIN_PASSWORD=replace-with-a-strong-password

# Public data providers may be disabled in restricted environments
PUBLIC_CONTEXT_ENABLED=true

# Per-client limits, fixed one-minute window (single instance only)
FORGE_WRITE_LIMIT=60
FORGE_CONTEXT_LIMIT=30

# Set to "silent" to suppress the structured per-request log line
# FORGE_LOG=silent

# Generative AI: off until a compatible Bedrock model and AWS identity are configured.
# Use AWS SSO/profile locally or an ECS task role. Never place AWS keys in browser code.
AI_PROVIDER=disabled
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

# Optional local demo persistence directory (not used with PostgreSQL)
# FORGE_DATA_DIR=data/runtime

# For RDS TLS: verified CA bundle available inside the container
# NODE_EXTRA_CA_CERTS=/app/certs/global-bundle.pem
